# Copy this file to .env and replace the placeholder values before running
# docker compose up. The .env file is git-ignored and must never be committed.

# SQL Server sa password. Must satisfy the SQL Server password policy:
# at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Strong#Pass1
MSSQL_DATABASE=TicketBookingPlatform

# Signing key for the JWT access tokens. Use at least 32 characters.
JWT_SIGNING_KEY=change-me-to-a-long-random-signing-key-0123456789

# Administrator account created by the startup seeding. Seeding is skipped when a user
# with this e-mail already exists, so set it to the administrator of your own database
# when restoring an existing backup.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_Admin#Pass1

# Host ports
API_PORT=8080
SPA_PORT=4200

# OTLP endpoint for exporting traces, metrics and logs (OpenTelemetry).
# Empty = exporting disabled; the API starts and serves traffic normally and sends nothing.
# To send telemetry to the optional Aspire Dashboard, start it and set this value:
#   docker compose --profile observability up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=

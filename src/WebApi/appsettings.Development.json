{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=TicketBookingPlatform;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "OpenApi": {
    "Enabled": true
  },
  "Https": {
    "HstsEnabled": false
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200" ]
  }
}

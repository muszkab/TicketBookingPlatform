{
  "name": "ticket-booking-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:version": "node scripts/generate-version.cjs",
    "prestart": "npm run generate:version",
    "start": "ng serve",
    "prebuild": "npm run generate:version",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prewatch": "npm run generate:version",
    "pretest": "npm run generate:version",
    "test": "ng test",
    "openapi:fetch": "curl -k --fail -s -o openapi/v1.json https://localhost:5001/openapi/v1.json && curl -k --fail -o openapi/v1.json https://localhost:5001/openapi/v1.json",
    "generate:api": "openapi-generator-cli generate -i openapi/v1.json -g typescript-angular -o src/app/api --additional-properties=fileNaming=kebab-case,ngVersion=22.0.0,providedInRoot=true,withInterfaces=true,npmName=@ticket-booking/api-client",
    "refresh:api": "npm run openapi:fetch && npm run generate:api",
    "generate:pdf-fonts": "node scripts/generate-pdf-fonts.cjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "angularx-qrcode": "^22.0.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
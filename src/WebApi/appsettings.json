{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Https": {
    "RedirectEnabled": true,
    "HstsEnabled": true
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "TicketBookingPlatform",
    "Audience": "TicketBookingApi",
    "AccessTokenExpirationMinutes": 60
  }
}
